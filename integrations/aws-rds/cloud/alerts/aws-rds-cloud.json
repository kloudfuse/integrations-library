            "hide": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "reducer": "mean",
            "refId": "B",
            "type": "reduce"
          },
          "queryType": "",
          "refId": "B",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          }
        },
        {
          "datasourceUid": "-100",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    80
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": []
                },
                "reducer": {
                  "params": [],
                  "type": "mean"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "name": "Expression",
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "$B > 80",
            "hide": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "math"
          },
          "queryType": "",
          "refId": "C",
          "relativeTimeRange": {
            "from": 0,
